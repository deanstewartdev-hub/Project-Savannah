# Copy to .env for local development. On Cloud Run, set these as service env vars /
# secrets instead — never commit a real .env file.

PORT=8080

# Shared secret required as a bearer token on incoming /jobs requests
# (Authorization: Bearer <JOB_SUBMIT_SECRET>). Apps Script must be configured with the
# same value via Secrets.setMediaWorkerSharedSecret() — it also embeds this value in the
# callback URL's query string, since Apps Script's doPost can't read custom headers.
JOB_SUBMIT_SECRET=

OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
PEXELS_API_KEY=

# Google Cloud Storage
GCS_BUCKET=savannah-media
# Local dev only: path to a service account key JSON. On Cloud Run, omit this and rely
# on the attached service account (Application Default Credentials).
GOOGLE_APPLICATION_CREDENTIALS=

# GCS object path (within GCS_BUCKET) to the curated music bed to use by default when a
# job does not specify musicTrackPath.
DEFAULT_MUSIC_TRACK_PATH=music/default-bed.mp3
